# Subscription Management System - Local Environment Configuration
# Backend configuration (copy to backend/.env)
FLASK_APP=backend.app:create_app
FLASK_ENV=development
SECRET_KEY=change-in-production-dev-secret-key-12345
JWT_SECRET_KEY=change-in-production-dev-jwt-secret-key-12345
JWT_ACCESS_TOKEN_EXPIRES=86400

# SQLite (Default Local Zero-Setup) or PostgreSQL:
DATABASE_URL=sqlite:///subscription_system.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop_sms

ADMIN_EMAIL=admin@brightloop.io
ADMIN_PASSWORD=Brightloop@2026!

FRONTEND_URL=http://localhost:5173
ENABLE_SCHEDULER=false

# Frontend configuration (copy to frontend/.env)
VITE_API_BASE_URL=/api/v1
